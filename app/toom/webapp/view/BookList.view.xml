<mvc:View
   controllerName="toom.controller.BookList"
   xmlns="sap.m"
   xmlns:core="sap.ui.core"
   xmlns:mvc="sap.ui.core.mvc">
   <List
      id="bookList"
      headerText="{i18n>bookListTitle}"
      class="sapUiResponsiveMargin"
      width="auto"
      items="{books>/Books}" >
      <items>
         <ObjectListItem
             type="Navigation"
             press=".onPress"
             title="{books>title}">
        </ObjectListItem>
      </items>
   </List>
</mvc:View>
