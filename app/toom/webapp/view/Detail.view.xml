<mvc:View
    controllerName="toom.controller.Detail"
    xmlns="sap.m"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:wt="toom.control">
    <Page title="Detail Page"
        showNavButton="true"
        navButtonPress=".onNavBack">
        <ObjectHeader 
            intro="Book"
            title="{books>title}" />

        <wt:ProductRating
            id="rating"
            class="sapUiSmallMarginBeginEnd"
            change=".onRatingChange" />
    </Page>
</mvc:View>
