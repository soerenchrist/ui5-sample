{
  "name": "toom_sample",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "type": "module",
  "repository": "<Add your repository here>",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "@cap-js/hana": "^1",
    "@sap-cloud-sdk/connectivity": "^4.0.2",
    "@sap-cloud-sdk/http-client": "^4.0.2",
    "@sap-cloud-sdk/resilience": "^4.0.2",
    "@sap/cds": "^8",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-types": "^0.8.0",
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8"
  },
  "scripts": {
    "start": "cds-serve",
    "build": "mbt build",
    "deploy": "cf deploy mta_archives/toom_sample_1.0.0.mtar"
  },
  "cds": {
    "sql": {
      "native_hana_associations": false
    },
    "requires": {
      "[production]": {
        "db": "hana",
        "auth": "xsuaa"
      },
      "[hybrid]": {
        "db": "hana"
      },
      "destinations": true,
      "html5-repo": true,
      "workzone": true,
      "ReviewService": {
        "kind": "odata",
        "model": "srv/external/ReviewService",
        "[production]": {
          "credentials": {
            "destination": "reviews",
            "path": "/odata/v4/reviews"
          }
        }
      }
    }
  }
}
